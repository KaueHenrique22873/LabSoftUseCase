@model AppTask.Models.Projeto
@{
    ViewData["Title"] = "Excluir projeto"; var nome = string.IsNullOrWhiteSpace(Model.Nome) ? "Sem nome informado" : Model.Nome.Trim(); var descricao = string.IsNullOrWhiteSpace(Model.Descricao) ? "Sem descrição" : Model.Descricao.Trim();
}
<style>
    .project-delete-page {
        max-width: 680px;
        margin: 0 auto;
        padding: 48px 0 65px;
        color: #172033
    }

    .project-delete-card {
        padding: 30px;
        border: 1px solid #ffd5da;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 30px #212f4d0b
    }

    .project-delete-icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        margin-bottom: 17px;
        border-radius: 14px;
        background: #ffe4e8;
        color: #b44a58;
        font-size: 1.35rem;
        font-weight: 900
    }

    .project-delete-card h1 {
        margin: 0 0 9px;
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -.04em
    }

    .project-delete-card p {
        color: #718096;
        line-height: 1.55
    }

    .project-delete-summary {
        margin: 20px 0;
        padding: 16px;
        border-radius: 11px;
        background: #f8f9fc
    }

        .project-delete-summary strong, .project-delete-summary small {
            display: block
        }

        .project-delete-summary small {
            margin-top: 6px;
            color: #718096
        }

    .project-delete-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #eef1f5
    }

    .project-delete-button {
        border: 0;
        border-radius: 10px;
        padding: 10px 17px;
        background: #b44a58;
        color: #fff;
        font-weight: 750
    }

        .project-delete-button:hover {
            background: #963c49
        }

    .project-back {
        color: #718096;
        font-weight: 700;
        text-decoration: none
    }

        .project-back:hover {
            color: #5c5ce2
        }
</style>
<div class="project-delete-page"><div class="project-delete-card"><div class="project-delete-icon">!</div><h1>Excluir projeto?</h1><p>Essa ação removerá o cadastro do projeto. Confirme somente se você tiver certeza de que deseja continuar.</p><div class="project-delete-summary"><strong>@nome</strong><small>@descricao · Código #@Model.Codigo</small></div><form asp-action="Delete"><input type="hidden" asp-for="Codigo" /><div class="project-delete-actions"><button type="submit" class="project-delete-button">Sim, excluir</button><a asp-action="Index" class="project-back">Cancelar</a></div></form></div></div>
