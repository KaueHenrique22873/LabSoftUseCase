@model IEnumerable<AppTask.Models.Projeto>
@{
    ViewData["Title"] = "Projetos"; var projetos = Model ?? Enumerable.Empty<AppTask.Models.Projeto>(); var total = projetos.Count();
}
<style>
    .projects-page {
        padding: 36px 0 58px;
        color: #172033
    }

    .projects-hero {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px
    }

    .projects-eyebrow {
        color: #5c5ce2;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase
    }

    .projects-hero h1 {
        margin: 7px 0 8px;
        font-size: clamp(2rem,4vw,3rem);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1
    }

    .projects-hero p {
        margin: 0;
        color: #718096
    }

    .project-primary {
        border: 0;
        border-radius: 11px;
        padding: 11px 17px;
        background: #5c5ce2;
        color: #fff;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 9px 20px #5c5ce233
    }

        .project-primary:hover {
            background: #4747bc;
            color: #fff
        }

    .project-stats {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 15px;
        margin-bottom: 20px
    }

        .project-stats article, .project-panel {
            padding: 20px;
            border: 1px solid #e7ebf1;
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 10px 30px #212f4d0b
        }

        .project-stats span, .project-stats small {
            display: block;
            color: #718096
        }

        .project-stats span {
            font-size: .8rem;
            font-weight: 700
        }

        .project-stats strong {
            display: block;
            margin: 8px 0 2px;
            font-size: 1.9rem
        }

        .project-stats small {
            font-size: .75rem
        }

    .project-panel {
        padding: 22px
    }

    .project-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px
    }

        .project-toolbar h2 {
            margin: 0;
            font-size: 1.08rem
        }

        .project-toolbar small {
            color: #718096
        }

    .project-search {
        min-width: 250px;
        border: 1px solid #e0e5ed;
        border-radius: 10px;
        padding: 9px 12px
    }

        .project-search:focus {
            border-color: #5c5ce2;
            outline: 0;
            box-shadow: 0 0 0 3px #5c5ce21f
        }

    .project-table-wrap {
        overflow-x: auto
    }

    .project-table {
        width: 100%;
        min-width: 850px;
        border-collapse: separate;
        border-spacing: 0
    }

        .project-table th {
            padding: 12px 13px;
            border-bottom: 1px solid #e7ebf1;
            color: #718096;
            font-size: .72rem;
            letter-spacing: .08em;
            text-transform: uppercase
        }

        .project-table td {
            padding: 15px 13px;
            border-bottom: 1px solid #f0f2f6;
            vertical-align: middle
        }

        .project-table tbody tr:hover {
            background: #fafaff
        }

    .project-name {
        display: flex;
        align-items: center;
        gap: 11px
    }

    .project-icon {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: #eeedff;
        color: #5c5ce2;
        font-weight: 850
    }

    .project-name strong, .project-name small {
        display: block
    }

    .project-name small, .project-description, .project-date {
        color: #718096;
        font-size: .8rem
    }

    .project-name strong {
        font-weight: 750
    }

    .project-actions {
        display: flex;
        justify-content: end;
        gap: 5px;
        white-space: nowrap
    }

        .project-actions a {
            border-radius: 8px;
            padding: 6px 9px;
            color: #718096;
            font-size: .78rem;
            font-weight: 700;
            text-decoration: none
        }

            .project-actions a:hover {
                color: #5c5ce2;
                background: #f0efff
            }

        .project-actions .danger:hover {
            color: #b44a58;
            background: #ffe4e8
        }

    .project-empty {
        display: none;
        padding: 35px;
        text-align: center;
        color: #718096
    }

        .project-empty strong {
            display: block;
            color: #172033
        }

    @@media(max-width:820px) {
        .projects-hero {
            align-items: start;
            flex-direction: column
        }

        .project-primary {
            width: 100%;
            text-align: center
        }

        .project-toolbar {
            align-items: start;
            flex-direction: column
        }

        .project-search {
            width: 100%;
            min-width: 0
        }
    }

    @@media(max-width:560px) {
        .project-stats {
            gap: 9px
        }

            .project-stats article {
                padding: 14px
            }

            .project-stats strong {
                font-size: 1.5rem
            }
    }
</style>
<div class="projects-page"><section class="projects-hero"><div><div class="projects-eyebrow">Planejamento e execução</div><h1>Projetos</h1><p>Organize iniciativas, prazos e entregas em um só lugar.</p></div><a asp-action="Create" class="btn project-primary">+ Novo projeto</a></section><section class="project-stats"><article><span>Total de projetos</span><strong>@total</strong><small>Projetos cadastrados</small></article><article><span>Gestão centralizada</span><strong>100%</strong><small>Informações organizadas</small></article><article><span>Próxima ação</span><strong>→</strong><small>Acompanhe seus prazos</small></article></section><section class="project-panel"><div class="project-toolbar"><div><h2>Lista de projetos</h2><small>Consulte nomes, descrições e períodos.</small></div><label><span class="visually-hidden">Buscar projeto</span><input id="projectSearch" class="project-search" type="search" placeholder="Buscar projeto..." /></label></div><div class="project-table-wrap"><table class="project-table"><thead><tr><th>Projeto</th><th>Descrição</th><th>Início</th><th>Fim</th><th class="text-end">Ações</th></tr></thead><tbody id="projectBody">@foreach(var item in projetos){var nome=string.IsNullOrWhiteSpace(item.Nome)?"Sem nome informado":item.Nome.Trim();var descricao=string.IsNullOrWhiteSpace(item.Descricao)?"Sem descrição":item.Descricao.Trim();
<tr data-search="@($"{nome} {descricao}".ToLowerInvariant())"><td><div class="project-name"><span class="project-icon">@nome.Substring(0, 1).ToUpperInvariant()</span><span><strong>@nome</strong><small>Código #@item.Codigo</small></span></div></td><td class="project-description">@descricao</td><td class="project-date">@item.DataInicio</td><td class="project-date">@item.DataFim</td><td><div class="project-actions"><a asp-action="Details" asp-route-id="@item.Codigo">Ver</a><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a class="danger" asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a></div></td></tr>
}
</tbody></table><div id="projectEmpty" class="project-empty"><strong>Nenhum projeto encontrado</strong><span>Tente buscar por outro nome ou descrição.</span></div></div></section></div>
@section Scripts {
    <script>(function(){const i=document.getElementById('projectSearch'),r=[...document.querySelectorAll('#projectBody tr')],e=document.getElementById('projectEmpty');function f(){let t=i.value.toLowerCase().trim(),n=0;r.forEach(x=>{let s=x.dataset.search.includes(t);x.hidden=!s;if(s)n++});e.style.display=n?'none':'block'}i.addEventListener('input',f);f()})();</script>
}
