@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Detalhes da tarefa";
    var descricao = string.IsNullOrWhiteSpace(Model.Descricao) ? "Tarefa sem descrição" : Model.Descricao.Trim();
    var status = string.IsNullOrWhiteSpace(Model.StatusTarefa) ? "Não informado" : Model.StatusTarefa.Trim();
}

<style>
    .task-details-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 38px 0 58px;
        color: #172033;
    }

    .task-eyebrow {
        color: #5c5ce2;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .task-details-page h1 {
        margin: 7px 0 8px;
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1;
    }

    .task-subtitle {
        margin-bottom: 25px;
        color: #718096;
    }

    .task-details-card {
        padding: 28px;
        border: 1px solid #e7ebf1;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(33, 47, 77, .06);
    }

    .task-details-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eef1f5;
    }

    .task-details-icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        margin-bottom: 13px;
        border-radius: 15px;
        background: #eeedff;
        color: #5c5ce2;
        font-size: 1.35rem;
        font-weight: 850;
    }

    .task-details-header h2 {
        margin: 0 0 6px;
        font-size: 1.35rem;
        line-height: 1.35;
    }

    .task-code {
        color: #718096;
        font-size: .82rem;
    }

    .task-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        padding: 7px 11px;
        background: #eeedff;
        color: #5353bd;
        font-size: .75rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .task-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

    .task-details-section-title {
        margin: 25px 0 17px;
        color: #172033;
        font-size: 1.03rem;
        font-weight: 800;
    }

    .task-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 24px;
    }

    .task-detail-item.full {
        grid-column: 1 / -1;
    }

    .task-detail-item small {
        display: block;
        color: #718096;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .task-detail-item strong {
        display: block;
        margin-top: 6px;
        color: #172033;
        font-size: .94rem;
        line-height: 1.5;
        word-break: break-word;
    }

        .task-detail-item strong.empty-value {
            color: #a0aabd;
            font-weight: 500;
        }

    .task-details-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 27px;
        padding-top: 22px;
        border-top: 1px solid #eef1f5;
    }

    .task-edit {
        border-radius: 10px;
        padding: 10px 18px;
        background: #5c5ce2;
        color: #fff;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 8px 17px rgba(92, 92, 226, .18);
    }

        .task-edit:hover {
            background: #4747bc;
            color: #fff;
        }

    .task-back {
        color: #718096;
        font-weight: 700;
        text-decoration: none;
    }

        .task-back:hover {
            color: #5c5ce2;
        }

    @@media (max-width: 640px) {
        .task-details-page {
            padding: 27px 0 44px;
        }

        .task-details-card {
            padding: 21px;
        }

        .task-details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .task-details-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .task-detail-item.full {
            grid-column: auto;
        }

        .task-details-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .task-edit,
        .task-back {
            width: 100%;
            text-align: center;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="task-details-page">
    <div class="task-eyebrow">Gestão de tarefas</div>
    <h1>Detalhes da tarefa</h1>
    <p class="task-subtitle">Acompanhe as informações, os prazos e o responsável por esta tarefa.</p>

    <div class="task-details-card">
        <div class="task-details-header">
            <div>
                <div class="task-details-icon">✓</div>
                <h2>@descricao</h2>
                <span class="task-code">Código #@Model.Codigo</span>
            </div>
            <span class="task-status">@status</span>
        </div>

        <h3 class="task-details-section-title">Informações e acompanhamento</h3>

        <div class="task-details-grid">
            <div class="task-detail-item full">
                <small>Descrição</small>
                <strong>@descricao</strong>
            </div>

            <div class="task-detail-item">
                <small>Data planejada</small>
                @if (Model.DataPlanejada == null)
                {
                    <strong class="empty-value">Não informada</strong>
                }
                else
                {
                    <strong>@Model.DataPlanejada</strong>
                }
            </div>

            <div class="task-detail-item">
                <small>Prazo</small>
                @if (Model.Prazo == null)
                {
                    <strong class="empty-value">Não informado</strong>
                }
                else
                {
                    <strong>@Model.Prazo</strong>
                }
            </div>

            <div class="task-detail-item">
                <small>Data de início</small>
                @if (Model.DataIniciada == null)
                {
                    <strong class="empty-value">Ainda não iniciada</strong>
                }
                else
                {
                    <strong>@Model.DataIniciada</strong>
                }
            </div>

            <div class="task-detail-item">
                <small>Data de finalização</small>
                @if (Model.DataFinalizada == null)
                {
                    <strong class="empty-value">Ainda não finalizada</strong>
                }
                else
                {
                    <strong>@Model.DataFinalizada</strong>
                }
            </div>

            <div class="task-detail-item">
                <small>Data de cancelamento</small>
                @if (Model.DataCancelada == null)
                {
                    <strong class="empty-value">Não cancelada</strong>
                }
                else
                {
                    <strong>@Model.DataCancelada</strong>
                }
            </div>

            <div class="task-detail-item">
                <small>Funcionário responsável</small>
                <strong>@(Model.Funcionario?.Codigo.ToString() ?? "Não atribuído")</strong>
            </div>
        </div>

        <div class="task-details-actions">
            <a asp-action="Edit" asp-route-id="@Model?.Codigo" class="task-edit">Editar tarefa</a>
            <a asp-action="Index" class="task-back">Voltar para lista</a>
        </div>
    </div>
</div>
