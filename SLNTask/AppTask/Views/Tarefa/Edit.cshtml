@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Editar tarefa";
}

<style>
    .task-edit-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 38px 0 58px;
        color: #172033;
    }

    .task-eyebrow {
        color: #5c5ce2;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .task-edit-page h1 {
        margin: 7px 0 8px;
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1;
    }

    .task-subtitle {
        margin-bottom: 25px;
        color: #718096;
    }

    .task-edit-card {
        padding: 28px;
        border: 1px solid #e7ebf1;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(33,47,77,.06);
    }

    .task-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 20px;
        padding-bottom: 13px;
        border-bottom: 1px solid #eef1f5;
        color: #172033;
        font-size: 1.08rem;
        font-weight: 800;
    }

        .task-section-title span {
            display: grid;
            place-items: center;
            width: 28px;
            height: 28px;
            border-radius: 9px;
            background: #eeedff;
            color: #5c5ce2;
            font-size: .8rem;
            font-weight: 850;
        }

    .task-field {
        margin-bottom: 18px;
    }

        .task-field label {
            margin-bottom: 7px;
            color: #172033;
            font-weight: 750;
        }

    .task-input, .task-select {
        min-height: 45px;
        border: 1px solid #dfe4ec;
        border-radius: 10px;
        padding: 10px 13px;
        color: #172033;
        background: #fff;
        transition: border-color .16s, box-shadow .16s;
    }

        .task-input:focus, .task-select:focus {
            border-color: #5c5ce2;
            outline: 0;
            box-shadow: 0 0 0 3px rgba(92,92,226,.12);
        }

        .task-input::placeholder {
            color: #a0aabd;
        }

    .task-date-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 16px;
    }

    .task-status-wrapper {
        padding: 16px;
        border-radius: 13px;
        background: #f8f9fc;
    }

        .task-status-wrapper .task-field {
            margin-bottom: 0;
        }

    .task-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 27px;
        padding-top: 22px;
        border-top: 1px solid #eef1f5;
    }

    .task-submit {
        border: 0;
        border-radius: 10px;
        padding: 11px 19px;
        background: #5c5ce2;
        color: #fff;
        font-weight: 750;
        box-shadow: 0 8px 17px rgba(92,92,226,.18);
        transition: transform .16s, background .16s;
    }

        .task-submit:hover {
            background: #4747bc;
            color: #fff;
            transform: translateY(-2px);
        }

        .task-submit:active {
            transform: scale(.97);
        }

    .task-back {
        color: #718096;
        font-weight: 700;
        text-decoration: none;
    }

        .task-back:hover {
            color: #5c5ce2;
        }

    .task-edit-card .text-danger {
        display: block;
        margin-top: 5px;
        font-size: .8rem;
    }

    @@media (max-width: 640px) {
        .task-edit-page {
            padding: 27px 0 44px;
        }

        .task-edit-card {
            padding: 21px;
        }

        .task-date-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .task-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .task-submit, .task-back {
            width: 100%;
            text-align: center;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="task-edit-page">
    <div class="task-eyebrow">Gestão de tarefas</div>
    <h1>Editar tarefa</h1>
    <p class="task-subtitle">Atualize as informações, os prazos e o responsável pela tarefa.</p>

    <div class="task-edit-card">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Codigo" />

            <h2 class="task-section-title"><span>1</span> Informações da tarefa</h2>
            <div class="task-field">
                <label asp-for="Descricao" class="form-label">Descrição da tarefa</label>
                <textarea asp-for="Descricao" class="form-control task-input" rows="3" autofocus></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="task-status-wrapper mb-4">
                <div class="task-field">
                    <label asp-for="StatusTarefa" class="form-label">Status da tarefa</label>
                    <input asp-for="StatusTarefa" class="form-control task-input" placeholder="Ex.: Em andamento" />
                    <span asp-validation-for="StatusTarefa" class="text-danger"></span>
                </div>
            </div>

            <h2 class="task-section-title"><span>2</span> Planejamento e prazos</h2>
            <div class="task-date-grid">
                <div class="task-field"><label asp-for="DataPlanejada" class="form-label">Data planejada</label><input asp-for="DataPlanejada" class="form-control task-input" /><span asp-validation-for="DataPlanejada" class="text-danger"></span></div>
                <div class="task-field"><label asp-for="Prazo" class="form-label">Prazo</label><input asp-for="Prazo" class="form-control task-input" /><span asp-validation-for="Prazo" class="text-danger"></span></div>
                <div class="task-field"><label asp-for="DataIniciada" class="form-label">Data de início</label><input asp-for="DataIniciada" class="form-control task-input" /><span asp-validation-for="DataIniciada" class="text-danger"></span></div>
                <div class="task-field"><label asp-for="DataFinalizada" class="form-label">Data de finalização</label><input asp-for="DataFinalizada" class="form-control task-input" /><span asp-validation-for="DataFinalizada" class="text-danger"></span></div>
                <div class="task-field"><label asp-for="DataCancelada" class="form-label">Data de cancelamento</label><input asp-for="DataCancelada" class="form-control task-input" /><span asp-validation-for="DataCancelada" class="text-danger"></span></div>
            </div>

            <h2 class="task-section-title"><span>3</span> Responsável</h2>
            <div class="task-field">
                <label asp-for="FuncionarioId" class="form-label">Funcionário responsável</label>
                <select asp-for="FuncionarioId" class="form-select task-select" asp-items="ViewBag.FuncionarioId"><option value="">Selecione um funcionário</option></select>
                <span asp-validation-for="FuncionarioId" class="text-danger"></span>
            </div>

            <div class="task-actions">
                <button type="submit" class="btn task-submit">Salvar alterações</button>
                <a asp-action="Index" class="task-back">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
