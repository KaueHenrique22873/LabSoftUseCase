@model AppTask.Models.Tarefa
@*[cite: 1] *@

@{
    ViewData["Title"] = "Editar Tarefa";
}

<style>
    /* Usa a mesma base do Create com pequenas adaptações semânticas */
    :root {
        --primary: #5C5CE2;
        --primary-hover: #4747BC;
        --text-main: #172033;
        --text-sec: #718096;
        --border: #E0E5ED;
        --bg: #F6F7FB;
        --card-bg: #FFFFFF;
    }

    .form-container {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
        padding: 58px 16px;
        min-height: 100vh;
        color: var(--text-main);
        display: flex;
        justify-content: center;
    }

    .form-wrapper {
        width: 100%;
        max-width: 760px;
    }

    .header-form {
        margin-bottom: 36px;
        text-align: center;
    }

    .eyebrow {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--primary);
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
        display: block;
    }

    .form-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 8px 0;
    }

    .form-desc {
        color: var(--text-sec);
        margin: 0;
    }

    .card {
        background: var(--card-bg);
        border-radius: 14px;
        padding: 40px;
        border: 1px solid var(--border);
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

    .form-group {
        margin-bottom: 24px;
    }

    .control-label {
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
        color: var(--text-main);
    }

    .form-control {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 11px 13px;
        font-size: 0.95rem;
        color: var(--text-main);
        transition: all 0.2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 3px rgba(92, 92, 226, 0.12);
        }

    .text-danger {
        font-size: 0.85rem;
        color: #B44A58;
        margin-top: 6px;
        display: block;
        font-weight: 500;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 40px;
        justify-content: flex-end;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 24px;
        font-weight: 750;
        font-size: 0.95rem;
        box-shadow: 0 4px 12px rgba(92, 92, 226, 0.2);
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-primary:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

    .btn-cancel {
        background: transparent;
        color: var(--text-sec);
        border: none;
        font-weight: 600;
        text-decoration: none;
        padding: 12px 16px;
        transition: color 0.2s;
    }

        .btn-cancel:hover {
            color: var(--primary);
        }

    .row-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 560px) {
        .card {
            padding: 24px;
        }

        .row-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }
</style>

<div class="form-container">
    <div class="form-wrapper">
        <div class="header-form">
            <span class="eyebrow">Edição</span>
            <h1 class="form-title">Editar Registro</h1>
            <p class="form-desc">Os dados desta tarefa podem ser atualizados abaixo.</p>
        </div>

        <div class="card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Codigo" />

                <div class="form-group">
                    <label asp-for="Descricao" class="control-label"></label>
                    <input asp-for="Descricao" class="form-control" />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="row-grid">
                    <div class="form-group">
                        <label asp-for="DataPlanejada" class="control-label"></label>
                        <input asp-for="DataPlanejada" class="form-control" type="date" />
                        <span asp-validation-for="DataPlanejada" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Prazo" class="control-label"></label>
                        <input asp-for="Prazo" class="form-control" type="date" />
                        <span asp-validation-for="Prazo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row-grid">
                    <div class="form-group">
                        <label asp-for="DataIniciada" class="control-label"></label>
                        <input asp-for="DataIniciada" class="form-control" type="date" />
                        <span asp-validation-for="DataIniciada" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DataFinalizada" class="control-label"></label>
                        <input asp-for="DataFinalizada" class="form-control" type="date" />
                        <span asp-validation-for="DataFinalizada" class="text-danger"></span>
                    </div>
                </div>

                <div class="row-grid">
                    <div class="form-group">
                        <label asp-for="StatusTarefa" class="control-label"></label>
                        <input asp-for="StatusTarefa" class="form-control" />
                        <span asp-validation-for="StatusTarefa" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FuncionarioId" class="control-label"></label>
                        <select asp-for="FuncionarioId" class="form-control" asp-items="ViewBag.FuncionarioId"></select>
                        <span asp-validation-for="FuncionarioId" class="text-danger"></span>
                    </div>
                </div>

                <div class="actions">
                    <a asp-action="Index" class="btn-cancel">Cancelar</a>
                    <input type="submit" value="Salvar Alterações" class="btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}