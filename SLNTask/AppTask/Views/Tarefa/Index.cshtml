@model IEnumerable<AppTask.Models.Tarefa>
@*[cite: 1] *@

@{
    ViewData["Title"] = "Gestão de Tarefas";
}

<style>
    :root {
        --primary: #5C5CE2;
        --primary-hover: #4747BC;
        --text-main: #172033;
        --text-sec: #718096;
        --border: #E7EBF1;
        --bg: #F6F7FB;
        --card-bg: #FFFFFF;
    }

    .app-container {
        font-family: 'Inter', 'Segoe UI', sans-serif;
        background: var(--bg);
        padding: 36px 16px;
        min-height: 100vh;
        color: var(--text-main);
    }

    .max-w {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 36px;
    }

    .eyebrow {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--primary);
        font-weight: 700;
        letter-spacing: 0.05em;
        margin-bottom: 4px;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 8px 0;
        color: var(--text-main);
    }

    .page-desc {
        color: var(--text-sec);
        margin: 0;
        font-size: 0.95rem;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 17px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 4px 12px rgba(92, 92, 226, 0.15);
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .btn-primary:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            color: white;
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-bottom: 36px;
    }

    .metric-card {
        background: var(--card-bg);
        border-radius: 14px;
        padding: 24px;
        border: 1px solid var(--border);
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .metric-label {
        font-size: 0.85rem;
        color: var(--text-sec);
        font-weight: 600;
        margin-bottom: 8px;
    }

    .metric-value {
        font-size: 2rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .table-card {
        background: var(--card-bg);
        border-radius: 14px;
        border: 1px solid var(--border);
        box-shadow: 0 4px 16px rgba(0,0,0,0.03);
        padding: 24px;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .table-header h2 {
            font-size: 1.25rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.01em;
        }

    .search-input {
        border: 1px solid #E0E5ED;
        border-radius: 10px;
        padding: 11px 13px;
        font-size: 0.9rem;
        width: 250px;
        transition: all 0.2s;
    }

        .search-input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 3px rgba(92, 92, 226, 0.12);
        }

    .table-responsive {
        overflow-x: auto;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

        .table th {
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-sec);
            font-weight: 700;
            padding: 16px 16px 16px 0;
            border-bottom: 2px solid #F0F2F6;
        }

        .table td {
            padding: 16px 16px 16px 0;
            border-bottom: 1px solid #F0F2F6;
            vertical-align: middle;
            color: var(--text-main);
            font-size: 0.95rem;
            transition: background 0.2s;
        }

        .table tbody tr:hover td {
            background-color: #FAFAFF;
        }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .badge-success {
        background: #DEF6EC;
        color: #24815E;
    }

        .badge-success::before {
            content: '';
            display: block;
            width: 6px;
            height: 6px;
            background: #24815E;
            border-radius: 50%;
            margin-right: 6px;
        }

    .actions {
        display: flex;
        gap: 12px;
        font-size: 0.9rem;
        font-weight: 600;
    }

        .actions a {
            color: var(--primary);
            text-decoration: none;
            transition: opacity 0.2s;
        }

            .actions a:hover {
                opacity: 0.8;
            }

            .actions a.delete {
                color: var(--text-sec);
            }

                .actions a.delete:hover {
                    color: #B44A58;
                }

    @@media (max-width: 820px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .btn-primary {
            width: 100%;
            justify-content: center;
        }

        .table-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .search-input {
            width: 100%;
        }

        .metrics-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 560px) {
        .metrics-grid {
            grid-template-columns: 1fr;
        }

        .app-container {
            padding: 24px 12px;
        }
    }
</style>

<div class="app-container">
    <div class="max-w">
        <header class="page-header">
            <div>
                <div class="eyebrow">AppTask • Gestão</div>
                <h1 class="page-title">Tarefas</h1>
                <p class="page-desc">Gerencie os incidentes e atividades cadastradas no sistema.</p>
            </div>
            <a asp-action="Create" class="btn-primary">Nova Tarefa</a>
        </header>

        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-label">Total de Tarefas</div>
                <p class="metric-value">@Model.Count()</p>
            </div>
            <div class="metric-card">
                <div class="metric-label">Abertas</div>
                <p class="metric-value">--</p>
            </div>
            <div class="metric-card">
                <div class="metric-label">Concluídas</div>
                <p class="metric-value">--</p>
            </div>
        </div>

        <div class="table-card">
            <div class="table-header">
                <h2>Listagem de Tarefas</h2>
                <input type="text" class="search-input" placeholder="Buscar tarefas..." aria-label="Buscar tarefas">
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                            <th>Prazo</th>
                            <th>Iniciada</th>
                            <th>Status</th>
                            <th>Funcionário</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-weight: 600;">@Html.DisplayFor(modelItem => item.Descricao)</td>
                                <td>@Html.DisplayFor(modelItem => item.Prazo)</td>
                                <td>@Html.DisplayFor(modelItem => item.DataIniciada)</td>
                                <td>
                                    <span class="badge badge-success">@Html.DisplayFor(modelItem => item.StatusTarefa)</span>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Funcionario.Codigo)</td>
                                <td>
                                    <div class="actions">
                                        <a asp-action="Details" asp-route-id="@item.Codigo">Detalhes</a>
                                        <a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@item.Codigo" class="delete">Excluir</a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" style="text-align: center; color: var(--text-sec); padding: 32px;">Nenhuma tarefa encontrada.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>