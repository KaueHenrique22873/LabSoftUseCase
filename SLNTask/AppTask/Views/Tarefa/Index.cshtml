@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefas";
    var tarefas = Model ?? Enumerable.Empty<AppTask.Models.Tarefa>();
    var totalTarefas = tarefas.Count();
    var tarefasConcluidas = tarefas.Count(t => !string.IsNullOrWhiteSpace(t.StatusTarefa) && t.StatusTarefa.ToLower().Contains("concl"));
    var tarefasPendentes = totalTarefas - tarefasConcluidas;
}

<style>
    .tasks-page {
        padding: 36px 0 58px;
        color: #172033;
    }

    .tasks-hero {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .tasks-eyebrow {
        color: #5c5ce2;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .tasks-hero h1 {
        margin: 7px 0 8px;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1;
    }

    .tasks-hero p {
        margin: 0;
        color: #718096;
    }

    .task-primary-button {
        border: 0;
        border-radius: 11px;
        padding: 11px 17px;
        background: #5c5ce2;
        color: #fff;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 9px 20px rgba(92,92,226,.2);
        transition: transform .16s, background .16s;
    }

        .task-primary-button:hover {
            background: #4747bc;
            color: #fff;
            transform: translateY(-2px);
        }

        .task-primary-button:active {
            transform: scale(.97);
        }

    .task-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .task-stat, .tasks-panel {
        border: 1px solid #e7ebf1;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(33,47,77,.045);
    }

    .task-stat {
        padding: 18px 20px;
    }

    .task-stat-label, .task-stat-helper {
        display: block;
        color: #718096;
    }

    .task-stat-label {
        font-size: .8rem;
        font-weight: 700;
    }

    .task-stat-value {
        display: block;
        margin: 8px 0 2px;
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -.05em;
    }

    .task-stat-helper {
        font-size: .75rem;
    }

    .tasks-panel {
        padding: 22px;
    }

    .tasks-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

        .tasks-toolbar h2 {
            margin: 0;
            font-size: 1.08rem;
            letter-spacing: -.02em;
        }

        .tasks-toolbar small {
            color: #718096;
        }

    .tasks-controls {
        display: flex;
        gap: 10px;
    }

    .task-search, .task-filter {
        border: 1px solid #e0e5ed;
        border-radius: 10px;
        padding: 9px 12px;
        color: #172033;
        background: #fff;
    }

    .task-search {
        min-width: 240px;
    }

        .task-search:focus, .task-filter:focus {
            border-color: #5c5ce2;
            outline: 0;
            box-shadow: 0 0 0 3px rgba(92,92,226,.12);
        }

    .tasks-table-wrap {
        overflow-x: auto;
    }

    .tasks-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .tasks-table th {
            padding: 12px 13px;
            border-bottom: 1px solid #e7ebf1;
            color: #718096;
            font-size: .72rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .tasks-table td {
            padding: 15px 13px;
            border-bottom: 1px solid #f0f2f6;
            vertical-align: middle;
        }

        .tasks-table tbody tr {
            transition: background .16s;
        }

            .tasks-table tbody tr:hover {
                background: #fafaff;
            }

    .task-description {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 230px;
    }

    .task-icon {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        border-radius: 11px;
        background: #eeedff;
        color: #5c5ce2;
        font-weight: 850;
    }

    .task-description strong {
        display: block;
        max-width: 280px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 750;
    }

    .task-description small, .task-date, .task-employee {
        color: #718096;
        font-size: .78rem;
    }

    .task-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 9px;
        background: #eeedff;
        color: #5353bd;
        font-size: .7rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .task-status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .task-status.completed {
            background: #def6ec;
            color: #24815e;
        }

        .task-status.cancelled {
            background: #ffe4e8;
            color: #b44a58;
        }

        .task-status.pending {
            background: #fff0d6;
            color: #9b651d;
        }

    .task-actions {
        display: flex;
        justify-content: end;
        gap: 5px;
        white-space: nowrap;
    }

        .task-actions a {
            border-radius: 8px;
            padding: 6px 9px;
            color: #718096;
            font-size: .78rem;
            font-weight: 700;
            text-decoration: none;
        }

            .task-actions a:hover {
                color: #5c5ce2;
                background: #f0efff;
            }

            .task-actions a.danger:hover {
                color: #b44a58;
                background: #ffe4e8;
            }

    .task-empty {
        display: none;
        padding: 38px 20px;
        color: #718096;
        text-align: center;
    }

        .task-empty strong {
            display: block;
            margin-bottom: 5px;
            color: #172033;
        }

    @@media (max-width: 900px) {
        .tasks-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .task-primary-button {
            width: 100%;
            text-align: center;
        }

        .tasks-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .tasks-controls {
            width: 100%;
        }

        .task-search {
            flex: 1;
            min-width: 0;
        }
    }

    @@media (max-width: 560px) {
        .tasks-page {
            padding: 27px 0 44px;
        }

        .task-stats {
            gap: 9px;
        }

        .task-stat {
            padding: 14px;
        }

        .task-stat-value {
            font-size: 1.5rem;
        }

        .tasks-controls {
            align-items: stretch;
            flex-direction: column;
        }

        .task-search {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="tasks-page">
    <section class="tasks-hero">
        <div>
            <div class="tasks-eyebrow">Organização e produtividade</div>
            <h1>Tarefas</h1>
            <p>Acompanhe o progresso do trabalho, prazos e responsáveis.</p>
        </div>
        <a asp-action="Create" class="btn task-primary-button">+ Nova tarefa</a>
    </section>

    <section class="task-stats" aria-label="Resumo das tarefas">
        <article class="task-stat"><span class="task-stat-label">Total de tarefas</span><strong class="task-stat-value">@totalTarefas</strong><small class="task-stat-helper">Registros cadastrados</small></article>
        <article class="task-stat"><span class="task-stat-label">Concluídas</span><strong class="task-stat-value">@tarefasConcluidas</strong><small class="task-stat-helper">Tarefas finalizadas</small></article>
        <article class="task-stat"><span class="task-stat-label">Em acompanhamento</span><strong class="task-stat-value">@tarefasPendentes</strong><small class="task-stat-helper">Pendentes ou em andamento</small></article>
    </section>

    <section class="tasks-panel">
        <div class="tasks-toolbar">
            <div><h2>Lista de tarefas</h2><small>Consulte e gerencie todas as atividades.</small></div>
            <div class="tasks-controls">
                <label><span class="visually-hidden">Buscar tarefa</span><input id="taskSearch" class="task-search" type="search" placeholder="Buscar por descrição..." /></label>
                <label><span class="visually-hidden">Filtrar por status</span><select id="taskFilter" class="task-filter"><option value="all">Todos os status</option><option value="completed">Concluídas</option><option value="pending">Em acompanhamento</option><option value="cancelled">Canceladas</option></select></label>
            </div>
        </div>

        <div class="tasks-table-wrap">
            <table class="tasks-table">
                <thead><tr><th>Tarefa</th><th>Planejada</th><th>Iniciada</th><th>Finalizada</th><th>Cancelada</th><th>Status</th><th>Prazo</th><th>Funcionário</th><th class="text-end">Ações</th></tr></thead>
                <tbody id="tasksBody">
                    @foreach (var item in tarefas)
                    {
                        var descricao = string.IsNullOrWhiteSpace(item.Descricao) ? "Tarefa sem descrição" : item.Descricao.Trim();
                        var statusTexto = string.IsNullOrWhiteSpace(item.StatusTarefa) ? "Não informado" : item.StatusTarefa.Trim();
                        var statusNormalizado = statusTexto.ToLowerInvariant();
                        var statusClasse = statusNormalizado.Contains("concl") ? "completed" : statusNormalizado.Contains("cancel") ? "cancelled" : "pending";
                        <tr data-search="@($"{descricao} {statusTexto}".ToLowerInvariant())" data-status="@statusClasse">
                            <td><div class="task-description"><span class="task-icon">✓</span><span><strong title="@descricao">@descricao</strong><small>Código #@item.Codigo</small></span></div></td>
                            <td class="task-date">@item.DataPlanejada</td>
                            <td class="task-date">@item.DataIniciada</td>
                            <td class="task-date">@item.DataFinalizada</td>
                            <td class="task-date">@item.DataCancelada</td>
                            <td><span class="task-status @statusClasse">@statusTexto</span></td>
                            <td class="task-date">@item.Prazo</td>
                            <td class="task-employee">@(item.Funcionario?.Codigo.ToString() ?? "Não atribuído")</td>
                            <td><div class="task-actions"><a asp-action="Details" asp-route-id="@item.Codigo">Ver</a><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a class="danger" asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a></div></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="taskEmpty" class="task-empty"><strong>Nenhuma tarefa encontrada</strong><span>Tente ajustar a busca ou o filtro de status.</span></div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const search = document.getElementById('taskSearch');
            const filter = document.getElementById('taskFilter');
            const rows = Array.from(document.querySelectorAll('#tasksBody tr'));
            const empty = document.getElementById('taskEmpty');
            function filterTasks() {
                const term = search.value.trim().toLowerCase();
                const selected = filter.value;
                let visible = 0;
                rows.forEach(function (row) {
                    const show = row.dataset.search.includes(term) && (selected === 'all' || row.dataset.status === selected);
                    row.hidden = !show;
                    if (show) visible++;
                });
                empty.style.display = visible ? 'none' : 'block';
            }
            search.addEventListener('input', filterTasks);
            filter.addEventListener('change', filterTasks);
            filterTasks();
        })();
    </script>
}
