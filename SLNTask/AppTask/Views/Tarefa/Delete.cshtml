@model AppTask.Models.Tarefa
@*[cite: 1] *@

@{
    ViewData["Title"] = "Excluir Tarefa";
}

<style>
    :root {
        --danger: #B44A58;
        --danger-hover: #963C49;
        --danger-bg: #FFE4E8;
        --text-main: #172033;
        --text-sec: #718096;
        --border: #E0E5ED;
        --bg: #F6F7FB;
        --card-bg: #FFFFFF;
    }

    .delete-container {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
        padding: 58px 16px;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .delete-wrapper {
        width: 100%;
        max-width: 520px;
    }

    .card-alert {
        background: var(--card-bg);
        border-radius: 14px;
        padding: 32px;
        border: 1px solid #F5C6CB;
        box-shadow: 0 8px 24px rgba(180,74,88,0.1);
        text-align: center;
    }

    .alert-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--danger-bg);
        color: var(--danger);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 2rem;
        margin: 0 auto 20px auto;
        font-weight: bold;
    }

    .alert-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
    }

    .alert-desc {
        color: var(--text-sec);
        font-size: 0.95rem;
        line-height: 1.5;
        margin: 0 0 24px 0;
    }

    .summary-box {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px;
        text-align: left;
        margin-bottom: 32px;
    }

        .summary-box strong {
            display: block;
            color: var(--text-main);
            font-size: 1.1rem;
            margin-bottom: 4px;
        }

        .summary-box span {
            color: var(--text-sec);
            font-size: 0.85rem;
        }

    .actions {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn-danger {
        background: var(--danger);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 24px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.2s;
        box-shadow: 0 4px 12px rgba(180,74,88,0.2);
    }

        .btn-danger:hover {
            background: var(--danger-hover);
        }

    .btn-cancel {
        background: transparent;
        color: var(--text-sec);
        text-decoration: none;
        padding: 12px 16px;
        font-weight: 600;
        border-radius: 10px;
        transition: background 0.2s;
    }

        .btn-cancel:hover {
            background: #F0F2F6;
            color: var(--text-main);
        }

    @@media (max-width: 560px) {
        .actions {
            flex-direction: column;
        }

        .btn-danger, .btn-cancel {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<div class="delete-container">
    <div class="delete-wrapper">
        <div class="card-alert">
            <div class="alert-icon">!</div>
            <h1 class="alert-title">Excluir registro?</h1>
            <p class="alert-desc">Tem certeza que deseja remover esta tarefa? Esta ação não poderá ser desfeita e os dados serão perdidos.</p>

            <div class="summary-box">
                <strong>@Html.DisplayFor(model => model.Descricao)</strong>
                <span>Prazo: @Html.DisplayFor(model => model.Prazo) | Status: @Html.DisplayFor(model => model.StatusTarefa)</span>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Codigo" />
                <div class="actions">
                    <a asp-action="Index" class="btn-cancel">Cancelar</a>
                    <input type="submit" value="Sim, excluir" class="btn-danger" />
                </div>
            </form>
        </div>
    </div>
</div>