@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Excluir tarefa";
    var descricao = string.IsNullOrWhiteSpace(Model.Descricao) ? "Tarefa sem descrição" : Model.Descricao.Trim();
}

<style>
    .task-delete-page {
        max-width: 820px;
        margin: 0 auto;
        padding: 45px 0 65px;
        color: #172033;
    }

    .task-delete-card {
        padding: 30px;
        border: 1px solid #ffd5da;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(33, 47, 77, .06);
    }

    .task-delete-icon {
        display: grid;
        place-items: center;
        width: 50px;
        height: 50px;
        margin-bottom: 18px;
        border-radius: 15px;
        background: #ffe4e8;
        color: #b44a58;
        font-size: 1.4rem;
        font-weight: 900;
    }

    .task-delete-eyebrow {
        color: #b44a58;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .task-delete-card h1 {
        margin: 7px 0 9px;
        font-size: clamp(1.9rem, 4vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -.05em;
    }

    .task-delete-description {
        margin-bottom: 24px;
        color: #718096;
        line-height: 1.6;
    }

    .task-summary {
        margin-bottom: 24px;
        padding: 20px;
        border-radius: 13px;
        background: #f8f9fc;
    }

    .task-summary-title {
        margin-bottom: 17px;
        color: #172033;
        font-size: 1.05rem;
        font-weight: 800;
    }

    .task-summary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px 22px;
    }

    .task-summary-item.full {
        grid-column: 1 / -1;
    }

    .task-summary-item small {
        display: block;
        color: #718096;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .task-summary-item strong {
        display: block;
        margin-top: 5px;
        color: #172033;
        font-size: .92rem;
        line-height: 1.45;
        word-break: break-word;
    }

    .task-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 10px;
        background: #eeedff;
        color: #5353bd;
        font-size: .75rem;
        font-weight: 800;
    }

    .task-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 22px;
        border-top: 1px solid #eef1f5;
    }

    .task-delete-button {
        border: 0;
        border-radius: 10px;
        padding: 11px 18px;
        background: #b44a58;
        color: #fff;
        font-weight: 750;
        transition: transform .16s, background .16s;
    }

        .task-delete-button:hover {
            background: #963c49;
        }

        .task-delete-button:active {
            transform: scale(.97);
        }

    .task-back {
        color: #718096;
        font-weight: 700;
        text-decoration: none;
    }

        .task-back:hover {
            color: #5c5ce2;
        }

    @@media (max-width: 620px) {
        .task-delete-page {
            padding: 27px 0 44px;
        }

        .task-delete-card {
            padding: 21px;
        }

        .task-summary-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .task-summary-item.full {
            grid-column: auto;
        }

        .task-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .task-delete-button,
        .task-back {
            width: 100%;
            text-align: center;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="task-delete-page">
    <div class="task-delete-card">
        <div class="task-delete-icon">!</div>
        <div class="task-delete-eyebrow">Atenção necessária</div>
        <h1>Excluir tarefa?</h1>
        <p class="task-delete-description">
            Essa ação removerá permanentemente o cadastro da tarefa.
            Confirme somente se você tiver certeza de que deseja continuar.
        </p>

        <div class="task-summary">
            <div class="task-summary-title">Resumo da tarefa</div>
            <div class="task-summary-grid">
                <div class="task-summary-item full">
                    <small>Descrição</small>
                    <strong>@descricao</strong>
                </div>

                <div class="task-summary-item">
                    <small>Data planejada</small>
                    <strong>@Model.DataPlanejada</strong>
                </div>

                <div class="task-summary-item">
                    <small>Prazo</small>
                    <strong>@Model.Prazo</strong>
                </div>

                <div class="task-summary-item">
                    <small>Data iniciada</small>
                    <strong>@Model.DataIniciada</strong>
                </div>

                <div class="task-summary-item">
                    <small>Data finalizada</small>
                    <strong>@Model.DataFinalizada</strong>
                </div>

                <div class="task-summary-item">
                    <small>Data cancelada</small>
                    <strong>@Model.DataCancelada</strong>
                </div>

                <div class="task-summary-item">
                    <small>Status</small>
                    <strong><span class="task-status">@Model.StatusTarefa</span></strong>
                </div>

                <div class="task-summary-item">
                    <small>Funcionário</small>
                    <strong>@(Model.Funcionario?.Codigo.ToString() ?? "Não atribuído")</strong>
                </div>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Codigo" />
            <div class="task-actions">
                <button type="submit" class="task-delete-button">Sim, excluir tarefa</button>
                <a asp-action="Index" class="task-back">Cancelar e voltar</a>
            </div>
        </form>
    </div>
</div>
