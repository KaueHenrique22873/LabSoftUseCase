@model IEnumerable<AppTask.Models.Incidente>
@{
    ViewData["Title"] = "Incidentes"; var incidentes = Model ?? Enumerable.Empty<AppTask.Models.Incidente>(); var total = incidentes.Count(); var resolvidos = incidentes.Count(i => i.Resolvido == true);
}
<style>
    .incidents-page {
        padding: 36px 0 58px;
        color: #172033
    }

    .incidents-hero {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px
    }

    .incidents-eyebrow {
        color: #5c5ce2;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase
    }

    .incidents-hero h1 {
        margin: 7px 0 8px;
        font-size: clamp(2rem,4vw,3rem);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1
    }

    .incidents-hero p {
        margin: 0;
        color: #718096
    }

    .incident-primary {
        border: 0;
        border-radius: 11px;
        padding: 11px 17px;
        background: #5c5ce2;
        color: #fff;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 9px 20px #5c5ce233
    }

        .incident-primary:hover {
            background: #4747bc;
            color: #fff
        }

    .incident-stats {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 15px;
        margin-bottom: 20px
    }

        .incident-stats article, .incident-panel {
            padding: 20px;
            border: 1px solid #e7ebf1;
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 10px 30px #212f4d0b
        }

        .incident-stats span, .incident-stats small {
            display: block;
            color: #718096
        }

        .incident-stats span {
            font-size: .8rem;
            font-weight: 700
        }

        .incident-stats strong {
            display: block;
            margin: 8px 0 2px;
            font-size: 1.9rem
        }

        .incident-stats small {
            font-size: .75rem
        }

    .incident-panel {
        padding: 22px
    }

    .incident-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px
    }

        .incident-toolbar h2 {
            margin: 0;
            font-size: 1.08rem
        }

        .incident-toolbar small {
            color: #718096
        }

    .incident-search {
        min-width: 250px;
        border: 1px solid #e0e5ed;
        border-radius: 10px;
        padding: 9px 12px
    }

        .incident-search:focus {
            border-color: #5c5ce2;
            outline: 0;
            box-shadow: 0 0 0 3px #5c5ce21f
        }

    .incident-table-wrap {
        overflow-x: auto
    }

    .incident-table {
        width: 100%;
        min-width: 900px;
        border-collapse: separate;
        border-spacing: 0
    }

        .incident-table th {
            padding: 12px 13px;
            border-bottom: 1px solid #e7ebf1;
            color: #718096;
            font-size: .72rem;
            letter-spacing: .08em;
            text-transform: uppercase
        }

        .incident-table td {
            padding: 15px 13px;
            border-bottom: 1px solid #f0f2f6;
            vertical-align: middle
        }

        .incident-table tbody tr:hover {
            background: #fafaff
        }

    .incident-description {
        font-weight: 750
    }

    .incident-date, .incident-solution {
        color: #718096;
        font-size: .82rem
    }

    .incident-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: .7rem;
        font-weight: 800
    }

        .incident-status:before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor
        }

        .incident-status.resolved {
            background: #def6ec;
            color: #24815e
        }

        .incident-status.open {
            background: #fff0d6;
            color: #9b651d
        }

    .incident-actions {
        display: flex;
        justify-content: end;
        gap: 5px;
        white-space: nowrap
    }

        .incident-actions a {
            border-radius: 8px;
            padding: 6px 9px;
            color: #718096;
            font-size: .78rem;
            font-weight: 700;
            text-decoration: none
        }

            .incident-actions a:hover {
                color: #5c5ce2;
                background: #f0efff
            }

        .incident-actions .danger:hover {
            color: #b44a58;
            background: #ffe4e8
        }

    .incident-empty {
        display: none;
        padding: 35px;
        text-align: center;
        color: #718096
    }

        .incident-empty strong {
            display: block;
            color: #172033
        }

    @@media(max-width:820px) {
        .incidents-hero {
            align-items: start;
            flex-direction: column
        }

        .incident-primary {
            width: 100%;
            text-align: center
        }

        .incident-toolbar {
            align-items: start;
            flex-direction: column
        }

        .incident-search {
            width: 100%;
            min-width: 0
        }
    }

    @@media(max-width:560px) {
        .incident-stats {
            gap: 9px
        }

            .incident-stats article {
                padding: 14px
            }

            .incident-stats strong {
                font-size: 1.5rem
            }
    }
</style>
<div class="incidents-page"><section class="incidents-hero"><div><div class="incidents-eyebrow">Monitoramento operacional</div><h1>Incidentes</h1><p>Registre problemas, acompanhe soluções e mantenha a operação estável.</p></div><a asp-action="Create" class="btn incident-primary">+ Novo incidente</a></section><section class="incident-stats"><article><span>Total de incidentes</span><strong>@total</strong><small>Registros cadastrados</small></article><article><span>Em aberto</span><strong>@(total - resolvidos)</strong><small>Aguardando solução</small></article><article><span>Resolvidos</span><strong>@resolvidos</strong><small>Incidentes finalizados</small></article></section><section class="incident-panel"><div class="incident-toolbar"><div><h2>Registro de incidentes</h2><small>Pesquise por descrição ou solução.</small></div><label><span class="visually-hidden">Buscar incidente</span><input id="incidentSearch" class="incident-search" type="search" placeholder="Buscar incidente..." /></label></div><div class="incident-table-wrap"><table class="incident-table"><thead><tr><th>Problema</th><th>Data</th><th>Solução</th><th>Status</th><th>Funcionário</th><th class="text-end">Ações</th></tr></thead><tbody id="incidentBody">@foreach(var item in incidentes){var problema=string.IsNullOrWhiteSpace(item.DescricaoProblema)?"Sem descrição":item.DescricaoProblema.Trim();var solucao=string.IsNullOrWhiteSpace(item.Solucao)?"Não informada":item.Solucao.Trim();
<tr data-search="@($"{problema} {solucao}".ToLowerInvariant())"><td class="incident-description">@problema</td><td class="incident-date">@item.DataIncidente</td><td class="incident-solution">@solucao</td><td><span class="incident-status @(item.Resolvido == true ? "resolved" : "open")">@(item.Resolvido == true ? "Resolvido" : "Em aberto")</span></td><td>@(item.Funcionario?.Codigo.ToString() ?? "Não atribuído")</td><td><div class="incident-actions"><a asp-action="Details" asp-route-id="@item.Codigo">Ver</a><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a class="danger" asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a></div></td></tr>
}
</tbody></table><div id="incidentEmpty" class="incident-empty"><strong>Nenhum incidente encontrado</strong><span>Tente buscar por outro termo.</span></div></div></section></div>
@section Scripts {
    <script>(function(){const i=document.getElementById('incidentSearch'),r=[...document.querySelectorAll('#incidentBody tr')],e=document.getElementById('incidentEmpty');function f(){let t=i.value.toLowerCase().trim(),n=0;r.forEach(x=>{let s=x.dataset.search.includes(t);x.hidden=!s;if(s)n++});e.style.display=n?'none':'block'}i.addEventListener('input',f);f()})();</script>
}
