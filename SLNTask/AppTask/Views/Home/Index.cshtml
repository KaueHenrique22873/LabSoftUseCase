@{
    ViewData["Title"] = "Painel de controle";
}

<style>
    :root {
        --ink: #162033;
        --muted: #6f7b8f;
        --line: #e7ebf1;
        --surface: #ffffff;
        --brand: #5c5ce2;
        --brand-dark: #4747bc;
        --mint: #dff6ed;
        --mint-ink: #25815e;
        --amber: #fff0d6;
        --amber-ink: #9b651d;
        --radius: 18px;
        --ease-out: cubic-bezier(.23, 1, .32, 1);
    }

    .dashboard-page {
        padding: 38px 0 58px;
    }

    .dashboard-hero {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 30px;
    }

    .dashboard-eyebrow {
        color: var(--brand);
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .dashboard-hero h1 {
        margin: 7px 0 8px;
        color: var(--ink);
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 1;
        letter-spacing: -.055em;
        font-weight: 800;
    }

    .dashboard-hero p {
        margin: 0;
        color: var(--muted);
        font-size: 1.03rem;
    }

    .dashboard-btn {
        background: var(--brand);
        border: 0;
        border-radius: 11px;
        padding: 11px 18px;
        color: #fff;
        font-weight: 750;
        box-shadow: 0 9px 20px rgba(92,92,226,.2);
        transition: transform .16s var(--ease-out), background .16s var(--ease-out);
    }

        .dashboard-btn:hover {
            background: var(--brand-dark);
            color: #fff;
            transform: translateY(-2px);
        }

        .dashboard-btn:active {
            transform: scale(.97);
        }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 28px;
    }

    .metric-card, .dashboard-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: 0 10px 30px rgba(33,47,77,.04);
    }

    .metric-card {
        padding: 20px;
        position: relative;
        overflow: hidden;
    }

        .metric-card::after {
            content: "";
            position: absolute;
            width: 78px;
            height: 78px;
            border-radius: 50%;
            right: -27px;
            top: -27px;
            background: #f1f0ff;
        }

    .metric-label {
        position: relative;
        z-index: 1;
        color: var(--muted);
        font-size: .84rem;
        font-weight: 650;
    }

    .metric-value {
        margin: 11px 0 5px;
        color: var(--ink);
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -.05em;
    }

    .metric-trend {
        color: var(--mint-ink);
        font-size: .78rem;
        font-weight: 700;
    }

    .dashboard-content {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(300px, .85fr);
        gap: 18px;
    }

    .dashboard-panel {
        padding: 23px;
    }

    .panel-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .panel-heading h2 {
            margin: 0;
            color: var(--ink);
            font-size: 1.08rem;
            letter-spacing: -.02em;
        }

    .panel-link {
        color: var(--brand);
        font-size: .82rem;
        font-weight: 750;
        text-decoration: none;
    }

        .panel-link:hover {
            color: var(--brand-dark);
            text-decoration: underline;
        }

    .task-list {
        display: grid;
        gap: 5px;
    }

    .task-row {
        display: grid;
        grid-template-columns: 34px 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 13px 8px;
        border-bottom: 1px solid #f0f2f6;
        transition: background .16s var(--ease-out), transform .16s var(--ease-out);
    }

        .task-row:last-child {
            border-bottom: 0;
        }

        .task-row:hover {
            background: #fafaff;
            transform: translateX(3px);
        }

    .task-check {
        width: 22px;
        height: 22px;
        accent-color: var(--brand);
        cursor: pointer;
    }

    .task-name {
        color: var(--ink);
        font-size: .92rem;
        font-weight: 720;
        margin-bottom: 4px;
    }

    .task-meta {
        color: var(--muted);
        font-size: .78rem;
    }

    .status-badge {
        padding: 5px 9px;
        border-radius: 99px;
        font-size: .7rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-progress {
        background: #e7e7ff;
        color: #5353bd;
    }

    .status-done {
        background: var(--mint);
        color: var(--mint-ink);
    }

    .status-pending {
        background: var(--amber);
        color: var(--amber-ink);
    }

    .activity-list {
        display: grid;
        gap: 19px;
    }

    .activity {
        display: grid;
        grid-template-columns: 32px 1fr;
        gap: 11px;
        position: relative;
    }

        .activity:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 15px;
            top: 32px;
            width: 1px;
            height: 24px;
            background: var(--line);
        }

    .avatar {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #eeeefe;
        color: var(--brand);
        font-size: .7rem;
        font-weight: 800;
    }

    .activity p {
        margin: 0;
        color: #384459;
        font-size: .82rem;
        line-height: 1.4;
    }

    .activity time {
        display: block;
        color: var(--muted);
        font-size: .72rem;
        margin-top: 3px;
    }
    @@media (max-width: 900px) {
        .metric-grid

    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-content {
        grid-template-columns: 1fr;
    }

    }
    @@media (max-width: 600px) {
        .dashboard-page

    {
        padding: 28px 0 45px;
    }

    .dashboard-hero {
        align-items: start;
        flex-direction: column;
    }

        .dashboard-hero .btn {
            width: 100%;
        }

    .metric-grid {
        gap: 10px;
    }

    .metric-card {
        padding: 15px;
    }

    .metric-value {
        font-size: 1.65rem;
    }

    .task-row {
        grid-template-columns: 28px 1fr;
    }

        .task-row .status-badge {
            grid-column: 2;
            justify-self: start;
        }

    }
    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        transition-duration: .01ms !important;
    }

    }
</style>

<div class="dashboard-page">
    <section class="dashboard-hero" aria-labelledby="page-title">
        <div>
            <div class="dashboard-eyebrow">Quinta-feira, 4 de setembro de 2026</div>
            <h1 id="page-title">Bom dia, equipe.</h1>
            <p>Acompanhe o andamento do trabalho e mantenha tudo no ritmo certo.</p>
        </div>
        <a class="btn dashboard-btn" asp-controller="Tarefa" asp-action="Create">+ Nova tarefa</a>
    </section>

    <section class="metric-grid" aria-label="Resumo do trabalho">
        <article class="metric-card"><div class="metric-label">Tarefas abertas</div><div class="metric-value">24</div><div class="metric-trend">↑ 12% nesta semana</div></article>
        <article class="metric-card"><div class="metric-label">Em andamento</div><div class="metric-value">08</div><div class="metric-trend">↑ 2 desde ontem</div></article>
        <article class="metric-card"><div class="metric-label">Concluídas</div><div class="metric-value">16</div><div class="metric-trend">↑ 18% de produtividade</div></article>
        <article class="metric-card"><div class="metric-label">Incidentes ativos</div><div class="metric-value">03</div><div class="metric-trend" style="color:#b44a58">↓ 1 nas últimas 24h</div></article>
    </section>

    <section class="dashboard-content">
        <article class="dashboard-panel">
            <div class="panel-heading"><h2>Minhas tarefas</h2><a class="panel-link" asp-controller="Tarefa" asp-action="Index">Ver todas →</a></div>
            <div class="task-list">
                <label class="task-row"><input class="task-check" type="checkbox" /><span><div class="task-name">Revisar requisitos do projeto Atlas</div><div class="task-meta">Projeto Atlas · vence hoje</div></span><span class="status-badge status-progress">Em andamento</span></label>
                <label class="task-row"><input class="task-check" type="checkbox" /><span><div class="task-name">Atualizar documentação da API</div><div class="task-meta">Projeto Interno · vence amanhã</div></span><span class="status-badge status-pending">Pendente</span></label>
                <label class="task-row"><input class="task-check" type="checkbox" checked /><span><div class="task-name">Validar fluxo de autenticação</div><div class="task-meta">Projeto Atlas · concluída hoje</div></span><span class="status-badge status-done">Concluída</span></label>
                <label class="task-row"><input class="task-check" type="checkbox" /><span><div class="task-name">Preparar reunião de sprint</div><div class="task-meta">Equipe de produto · 06 set</div></span><span class="status-badge status-pending">Pendente</span></label>
            </div>
        </article>
        <aside class="dashboard-panel">
            <div class="panel-heading"><h2>Atividade recente</h2><a class="panel-link" asp-controller="Tarefa" asp-action="Sobre">Detalhes</a></div>
            <div class="activity-list">
                <div class="activity"><span class="avatar">LM</span><div><p><strong>Luiza Martins</strong> concluiu uma tarefa.</p><time>há 18 minutos</time></div></div>
                <div class="activity"><span class="avatar">RC</span><div><p><strong>Rafael Costa</strong> atualizou o projeto Atlas.</p><time>há 1 hora</time></div></div>
                <div class="activity"><span class="avatar">AS</span><div><p><strong>Ana Souza</strong> registrou um novo incidente.</p><time>há 2 horas</time></div></div>
                <div class="activity"><span class="avatar">JP</span><div><p><strong>João Pedro</strong> entrou para a equipe.</p><time>ontem, às 16:42</time></div></div>
            </div>
        </aside>
    </section>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.task-check').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                const row = checkbox.closest('.task-row');
                row.style.opacity = checkbox.checked ? '.62' : '1';
            });
        });
    </script>
}
