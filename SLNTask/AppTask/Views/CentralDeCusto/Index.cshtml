@model IEnumerable<AppTask.Models.CentralDeCusto>

@{
    ViewData["Title"] = "Centrais de custo";
}

<style>
    :root {
        --brand: #5C5CE2;
        --brand-dark: #4747BC;
        --brand-light: #EEEDFF;
        --ink: #172033;
        --muted: #718096;
        --border: #E7EBF1;
        --surface: #FFF;
        --hover: #FAFAFF;
        --danger: #B44A58;
    }

    .cost-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 38px 0 58px;
        color: var(--ink);
        font-family: Inter,"Segoe UI",system-ui,sans-serif;
    }

    .cost-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 26px;
    }

    .eyebrow {
        color: var(--brand);
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .page-title {
        margin: 7px 0 8px;
        font-size: clamp(2rem,4vw,3rem);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1;
    }

    .page-subtitle {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
    }

    .primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 11px;
        padding: 10px 17px;
        background: var(--brand);
        color: #fff;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 8px 17px rgba(92,92,226,.18);
        transition: transform .16s,background .16s;
        white-space: nowrap;
    }

        .primary-button:hover {
            background: var(--brand-dark);
            color: #fff;
            transform: translateY(-2px);
        }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        padding: 18px 20px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: 0 10px 30px rgba(33,47,77,.045);
    }

    .record-count {
        color: var(--muted);
        font-size: .88rem;
        font-weight: 700;
    }

        .record-count strong {
            color: var(--ink);
        }

    .search-input {
        min-width: 240px;
        border: 1px solid #E0E5ED;
        border-radius: 10px;
        padding: 9px 12px;
        color: var(--ink);
    }

        .search-input:focus {
            border-color: var(--brand);
            outline: 0;
            box-shadow: 0 0 0 3px rgba(92,92,226,.12);
        }

    .table-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: 0 10px 30px rgba(33,47,77,.06);
    }

    .table-wrapper {
        overflow-x: auto;
        padding: 6px 20px 12px;
    }

    .table {
        width: 100%;
        min-width: 700px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table th {
            padding: 12px 13px;
            border-bottom: 1px solid var(--border);
            color: var(--muted);
            font-size: .72rem;
            letter-spacing: .08em;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .table td {
            padding: 15px 13px;
            border-bottom: 1px solid #F0F2F6;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background: var(--hover);
        }

        .table tbody tr:last-child td {
            border-bottom: 0;
        }

    .central-name {
        font-weight: 750;
    }

    .central-code {
        color: var(--muted);
        font-size: .78rem;
    }

    .money {
        color: var(--ink);
        font-weight: 750;
        white-space: nowrap;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .action-link {
        color: var(--brand);
        font-size: .86rem;
        font-weight: 750;
        text-decoration: none;
    }

        .action-link:hover {
            color: var(--brand-dark);
            text-decoration: underline;
        }

    .action-danger {
        color: var(--danger);
    }

    .empty-state {
        padding: 42px 20px;
        color: var(--muted);
        text-align: center;
    }

        .empty-state strong {
            display: block;
            margin-bottom: 6px;
            color: var(--ink);
            font-size: 1.05rem;
        }

    @@media (max-width:900px) {
        .cost-page {
            padding: 30px 15px 48px;
        }

        .cost-header, .toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .primary-button, .search-input {
            width: 100%;
        }
    }

    @@media (max-width:640px) {
        .cost-page {
            padding: 27px 15px 44px;
        }

        .toolbar {
            padding: 16px;
        }

        .table-wrapper {
            padding-left: 10px;
            padding-right: 10px;
        }
    }
</style>

<main class="cost-page">
    <header class="cost-header">
        <div>
            <span class="eyebrow">Administração financeira</span>
            <h1 class="page-title">Centrais de custo</h1>
            <p class="page-subtitle">Consulte e organize as metas anuais das suas centrais.</p>
        </div>
        <a asp-action="Create" class="primary-button">Nova central</a>
    </header>

    <section class="toolbar" aria-label="Ferramentas da listagem">
        <span class="record-count"><strong id="visibleCount">0</strong> registro(s) exibido(s)</span>
        <label class="visually-hidden" for="centralSearch">Buscar central de custo</label>
        <input id="centralSearch" class="search-input" type="search" placeholder="Buscar por nome..." autocomplete="off" />
    </section>

    <section class="table-card">
        <div class="table-wrapper">
            <table class="table" id="centralTable">
                <caption class="visually-hidden">Lista de centrais de custo cadastradas</caption>
                <thead>
                    <tr><th>Central de custo</th><th>Meta anual</th><th>Ações</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-search="@item.NomeCentral">
                            <td><span class="central-name">@item.NomeCentral</span><br /><span class="central-code">Código: @item.Codigo</span></td>
                            <td class="money">@item.ValorMetaAnual.ToString("C")</td>
                            <td><nav class="actions" aria-label="Ações para @item.NomeCentral"><a asp-action="Edit" asp-route-id="@item.Codigo" class="action-link">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo" class="action-link">Detalhes</a><a asp-action="Delete" asp-route-id="@item.Codigo" class="action-link action-danger">Excluir</a></nav></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="emptyState" class="empty-state" hidden><strong>Nenhuma central encontrada</strong><span>Tente buscar usando outro nome.</span></div>
        </div>
    </section>
</main>

<script>
    (() => {
        const input = document.getElementById('centralSearch');
        const rows = [...document.querySelectorAll('#centralTable tbody tr')];
        const count = document.getElementById('visibleCount');
        const empty = document.getElementById('emptyState');
        const filter = () => {
            const term = input.value.trim().toLocaleLowerCase();
            let visible = 0;
            rows.forEach(row => { const match = row.dataset.search.toLocaleLowerCase().includes(term); row.hidden = !match; if (match) visible++; });
            count.textContent = visible;
            empty.hidden = visible !== 0;
        };
        input.addEventListener('input', filter);
        filter();
    })();
</script>

<style>
    .visually-hidden {
        position: absolute !important;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
    }
</style>
