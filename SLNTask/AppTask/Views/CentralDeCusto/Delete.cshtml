@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Excluir central";
}

<style>
    :root {
        --brand: #5C5CE2;
        --ink: #172033;
        --muted: #718096;
        --border-danger: #FFD5DA;
        --danger: #B44A58;
        --danger-dark: #963C49;
        --danger-bg: #FFE4E8;
        --surface: #FFF;
    }

    .cost-page {
        max-width: 700px;
        margin: 0 auto;
        padding: 58px 0;
        color: var(--ink);
        font-family: Inter,"Segoe UI",system-ui,sans-serif;
    }

    .delete-card {
        padding: 30px;
        border: 1px solid var(--border-danger);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: 0 10px 30px rgba(33,47,77,.06);
    }

    .delete-icon {
        display: grid;
        place-items: center;
        width: 50px;
        height: 50px;
        margin-bottom: 20px;
        border-radius: 15px;
        background: var(--danger-bg);
        color: var(--danger);
        font-size: 1.4rem;
        font-weight: 900;
    }

    .eyebrow {
        color: var(--danger);
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .page-title {
        margin: 7px 0 8px;
        font-size: clamp(2rem,4vw,2.6rem);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1;
    }

    .page-subtitle {
        margin: 0 0 24px;
        color: var(--muted);
        line-height: 1.6;
    }

    .record-summary {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 18px;
        margin: 0 0 26px;
        padding: 20px;
        border: 1px solid #EEF1F5;
        border-radius: 14px;
        background: #F8F9FC;
    }

        .record-summary dt {
            color: var(--muted);
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .record-summary dd {
            margin: 6px 0 0;
            font-weight: 750;
        }

    .actions {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-top: 22px;
        border-top: 1px solid #EEF1F5;
    }

    .delete-button {
        border: 0;
        border-radius: 10px;
        padding: 10px 17px;
        background: var(--danger);
        color: #fff;
        font-weight: 750;
        cursor: pointer;
        transition: background .16s,transform .16s;
    }

        .delete-button:hover {
            background: var(--danger-dark);
            transform: translateY(-2px);
        }

    .cancel-link {
        color: var(--muted);
        font-weight: 700;
        text-decoration: none;
    }

        .cancel-link:hover {
            color: var(--brand);
        }

    @@media (max-width:640px) {
        .cost-page {
            padding: 27px 15px 44px;
        }

        .delete-card {
            padding: 21px;
        }

        .record-summary {
            grid-template-columns: 1fr;
        }

        .actions {
            align-items: stretch;
            flex-direction: column;
        }

            .actions a, .actions button {
                width: 100%;
                text-align: center;
            }
    }
</style>

<main class="cost-page">
    <section class="delete-card" aria-labelledby="delete-title">
        <div class="delete-icon" aria-hidden="true">!</div>
        <span class="eyebrow">Ação permanente</span>
        <h1 id="delete-title" class="page-title">Excluir registro?</h1>
        <p class="page-subtitle">Esta ação não poderá ser desfeita. Confirme a exclusão somente se tiver certeza.</p>

        <dl class="record-summary">
            <div><dt>Nome da central</dt><dd>@Model.NomeCentral</dd></div>
            <div><dt>Meta anual</dt><dd>@Model.ValorMetaAnual.ToString("C")</dd></div>
            <div><dt>Código</dt><dd>@Model.Codigo</dd></div>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Codigo" />
            <div class="actions">
                <button type="submit" class="delete-button">Excluir central</button>
                <a asp-action="Index" class="cancel-link">Cancelar</a>
            </div>
        </form>
    </section>
</main>
